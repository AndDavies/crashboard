# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy anon JWT, or use a modern publishable key where the client expects the anon slot:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key — server-only; required for POST /api/ingestion (bypasses RLS on ingestion tables)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: if set, POST /api/ingestion requires Authorization: Bearer <same value>
# INGESTION_API_SECRET=

# Telegram Bot webhook — setWebhook secret_token; verified via X-Telegram-Bot-Api-Secret-Token
# https://core.telegram.org/bots/api#setwebhook
TELEGRAM_WEBHOOK_SECRET=

# OpenClaw → Crashboard (Baggo Topics link drops). Required for POST /api/ingestion/openclaw
# and POST /api/ingestion/openclaw/structured (Leroy agent payloads)
# Authorization: Bearer <same value>
OPENCLAW_INGESTION_SECRET=

# Optional: project ref (Settings → General) — useful for Cursor MCP URL interpolation
# SUPABASE_PROJECT_REF=your-project-ref

# Public site origin (no trailing slash). Used to derive WHOOP callback if WHOOP_REDIRECT_URI is unset.
# Also used for X OAuth callback URL shown at /auth/x/start → {NEXT_PUBLIC_SITE_URL}/auth/x/callback
NEXT_PUBLIC_SITE_URL=https://crashboard.dev

# Google analytics / search verification — optional, public IDs only.
# GA4 web data stream Measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Optional GTM web container, e.g. GTM-XXXXXXX. If set, GTM loads instead of direct gtag.js.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Search Console HTML tag content value for:
# <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Consent Mode default. Use denied with the built-in banner, or granted if you intentionally run analytics by default.
NEXT_PUBLIC_GOOGLE_CONSENT_DEFAULT=denied

# WHOOP OAuth — Developer Dashboard → register Redirect URL exactly as shown below
# Docs: https://developer.whoop.com/docs/developing/oauth/#redirect-url
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Production (crashboard.dev): https://crashboard.dev/auth/whoop/callback
# Local dev: http://localhost:3000/auth/whoop/callback
# If omitted, defaults to NEXT_PUBLIC_SITE_URL + /auth/whoop/callback
WHOOP_REDIRECT_URI=https://crashboard.dev/auth/whoop/callback
# Space-separated scopes; include `offline` for refresh tokens (see WHOOP API scope docs)
# WHOOP_OAUTH_SCOPES=offline read:recovery read:sleep read:strain
