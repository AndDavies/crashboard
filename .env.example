# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy anon JWT, or use a modern publishable key where the client expects the anon slot:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: project ref (Settings → General) — useful for Cursor MCP URL interpolation
# SUPABASE_PROJECT_REF=your-project-ref

# Public site origin (no trailing slash). Used to derive WHOOP callback if WHOOP_REDIRECT_URI is unset.
NEXT_PUBLIC_SITE_URL=https://crashboard.dev

# WHOOP OAuth — Developer Dashboard → register Redirect URL exactly as shown below
# Docs: https://developer.whoop.com/docs/developing/oauth/#redirect-url
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Production (crashboard.dev): https://crashboard.dev/auth/whoop/callback
# Local dev: http://localhost:3000/auth/whoop/callback
# If omitted, defaults to NEXT_PUBLIC_SITE_URL + /auth/whoop/callback
WHOOP_REDIRECT_URI=https://crashboard.dev/auth/whoop/callback
# Space-separated scopes; include `offline` for refresh tokens (see WHOOP API scope docs)
# WHOOP_OAUTH_SCOPES=offline read:recovery read:sleep read:strain
