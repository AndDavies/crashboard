# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy anon JWT, or use a modern publishable key where the client expects the anon slot:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key — server-only; required for POST /api/ingestion (bypasses RLS on ingestion tables)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: if set, POST /api/ingestion requires Authorization: Bearer <same value>
# INGESTION_API_SECRET=

# Telegram Bot webhook — setWebhook secret_token; verified via X-Telegram-Bot-Api-Secret-Token
# https://core.telegram.org/bots/api#setwebhook
TELEGRAM_WEBHOOK_SECRET=

# OpenClaw → Crashboard (Baggo Topics link drops). Required for POST /api/ingestion/openclaw
# and POST /api/ingestion/openclaw/structured (Leroy agent payloads)
# Authorization: Bearer <same value>
OPENCLAW_INGESTION_SECRET=

# OpenAI — server-only; required for dashboard blog AI enrichment.
OPENAI_API_KEY=
# Optional model override for blog metadata enrichment. Defaults to gpt-5-mini.
# OPENAI_BLOG_ENRICHMENT_MODEL=gpt-5-mini
# Optional model override for dashboard media prompt generation. Defaults to gpt-5.5.
# OPENAI_PROMPT_BUILDER_MODEL=gpt-5.5

# Trend Intelligence — private Gmail ingestion, AI enrichment, and daily digest.
# Create a Google Cloud Web OAuth client and authorize these exact callbacks:
#   http://localhost:3000/api/intelligence/google/callback
#   https://crashboard.dev/api/intelligence/google/callback
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Optional; defaults to NEXT_PUBLIC_SITE_URL + /api/intelligence/google/callback
# GOOGLE_GMAIL_REDIRECT_URI=https://crashboard.dev/api/intelligence/google/callback
# Long random secret used to encrypt Gmail refresh tokens before database storage (32+ characters).
INTELLIGENCE_TOKEN_ENCRYPTION_KEY=
# Owner UUID from Supabase Auth, used only by scheduled server jobs.
INTELLIGENCE_OWNER_ID=
# Vercel Cron Authorization bearer. INTELLIGENCE_JOB_SECRET is accepted as a local fallback.
CRON_SECRET=
# INTELLIGENCE_JOB_SECRET=
# Optional digest recipient; defaults to the connected Gmail address.
# INTELLIGENCE_DIGEST_TO=m.andrew.davies@gmail.com
# Optional model overrides.
# OPENAI_INTELLIGENCE_EXTRACTION_MODEL=gpt-5.4-mini
# OPENAI_INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small
# Bounded research has safe defaults; set these only to override them.
# OPENAI_INTELLIGENCE_RESEARCH_MODEL=gpt-5.6-terra
# INTELLIGENCE_RESEARCH_DAILY_BUDGET_USD=5
# INTELLIGENCE_RESEARCH_MAX_USD_PER_LEAD=1
# Required to switch Overview, Explore, and the morning brief to the canonical v2 series.
INTELLIGENCE_SIGNALS_V2=true
# Enable only after the v2 daily series is verified. Sends at most two Strong New/Rising
# signals per Halifax day, and only when action or primary-source evidence is present.
INTELLIGENCE_IMMEDIATE_ALERTS_ENABLED=false

# Approved external APIs. Configure only when the matching source is activated.
# YouTube metadata always uses the official Data API. Caption downloads additionally
# require OAuth with youtube.force-ssl and permission to access the caption track.
# YOUTUBE_DATA_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# Approved Reddit API application credentials (OAuth client credentials flow).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Approved X API v2 application bearer token.
# X_API_BEARER_TOKEN=

# Optional: project ref (Settings → General) — useful for Cursor MCP URL interpolation
# SUPABASE_PROJECT_REF=your-project-ref

# Public site origin (no trailing slash). Used to derive WHOOP callback if WHOOP_REDIRECT_URI is unset.
# Also used for X OAuth callback URL shown at /auth/x/start → {NEXT_PUBLIC_SITE_URL}/auth/x/callback
NEXT_PUBLIC_SITE_URL=https://crashboard.dev

# Google analytics / search verification — optional, public IDs only.
# GA4 web data stream Measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Optional GTM web container, e.g. GTM-XXXXXXX. If set, GTM loads instead of direct gtag.js.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Search Console HTML tag content value for:
# <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Consent Mode default. Use denied with the built-in banner, or granted if you intentionally run analytics by default.
NEXT_PUBLIC_GOOGLE_CONSENT_DEFAULT=denied

# WHOOP OAuth — Developer Dashboard → register Redirect URL exactly as shown below
# Docs: https://developer.whoop.com/docs/developing/oauth/#redirect-url
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Production (crashboard.dev): https://crashboard.dev/auth/whoop/callback
# Local dev: http://localhost:3000/auth/whoop/callback
# If omitted, defaults to NEXT_PUBLIC_SITE_URL + /auth/whoop/callback
WHOOP_REDIRECT_URI=https://crashboard.dev/auth/whoop/callback
# Space-separated scopes; include `offline` for refresh tokens (see WHOOP API scope docs)
# WHOOP_OAUTH_SCOPES=offline read:recovery read:sleep read:strain
